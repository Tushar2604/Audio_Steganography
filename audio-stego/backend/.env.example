# Audio Steganography Backend — Environment Variables
DATABASE_URL=sqlite:///./audio_stego.db
CLERK_ISSUER=https://right-fowl-38.clerk.accounts.dev
# Optional alternative:
# CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json

# SMTP Settings (for email sending feature)
# Use Gmail App Password — not your regular password
# Enable 2FA on your Google account, then generate App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
